#!/bin/sh

zfs list -Hp -o name,usedbydataset,usedbyrefreservation,usedbysnapshots,usedbychildren,refer,lrefer | jq --raw-input --slurp '
def local_entries:
	[] +
	if .usedbydataset > 0 then
		[{
			name: "files",
			dsize: .usedbydataset,
			asize: .lrefer,
		}]
	elif .refer > 0 then
		[{
			name: "files",
			dsize: .refer,
			asize: .lrefer,
		}]
	else [] end +
	if .usedbyrefreservation > 0 then
		[{
			name: "refreservation",
			dsize: .usedbyrefreservation,
		}]
	else [] end +
	if .usedbysnapshots > 0 then
		[{
			name: "snapshots",
			dsize: .usedbysnapshots,
		}]
	else [] end
;

def to_ncdu:
	. as $all |
	(
		map(select(.name == []) | local_entries[])
		+
		(
			map(select((.name | length) > 0))
			| group_by(.name[0]) |
			map(
				[{name: .[0].name[0]}] + (map(.name = .name[1:]) | to_ncdu)
			)
		)
	)
;

def safe_tonumber:
	if . == "-" then 0 else tonumber end
;

[
	split("\n")[] | select(. != "") | split("\t") |
	{
		name: (.[0] | split("/")),
		usedbydataset: (.[1] | safe_tonumber),
		usedbyrefreservation: (.[2] | safe_tonumber),
		usedbysnapshots: (.[3] | safe_tonumber),
		usedbychildren: (.[4] | safe_tonumber),
		refer: (.[5] | safe_tonumber),
		lrefer: (.[6] | safe_tonumber),
	}
] as $lines |
[
	1,1,
	{progname: "zfs-list-to-ncdu"},
	[
		{name: "zfs:/"}
	] + ($lines | to_ncdu)
]
' | ncdu -f - "$@"
